        250,
        300
      ]
    },
    {
      "parameters": {
        "jsCode": "const crypto = require('crypto');\n\n// Clave Secreta Compartida configurada en WordPress\nconst secret = 'lhnkdkpwq9bpda8441zbx094bwlkb284379a';\nconst timestamp = Math.floor(Date.now() / 1000);\n\nconst body = {\n  trigger: 'cron_heartbeat',\n  timestamp: timestamp,\n  source: 'n8n_scheduler'\n};\n\nconst rawBody = JSON.stringify(body);\nconst signaturePayload = `${timestamp}.${rawBody}`;\nconst signature = crypto.createHmac('sha256', secret).update(signaturePayload).digest('hex');\n\nreturn [{\n  json: {\n    body: body,\n    headers: {\n      'Content-Type': 'application/json',\n      'X-AutoWA-Timestamp': timestamp.toString(),\n      'X-AutoWA-Signature': signature\n    }\n  }\n}];"
      },
      "id": "10000001-0001-0001-0001-000000000002",
      "name": "Calcular Firma HMAC",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        480,
        300
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=https://landing.autowhats.com.mx/wp-json/autowa/v1/cron-trigger",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
