            },
            {
              "name": "X-AutoWA-Signature",
              "value": "={{ $json.headers['X-AutoWA-Signature'] }}"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($json.body) }}",
        "options": {
          "timeout": 30000
        }
      },
      "id": "10000001-0001-0001-0001-000000000003",
      "name": "Disparar Cron en WordPress",
